<?xml version="1.0" encoding="utf-8"?>
<!-- NV-01: cobertura del producto (assembly APISDD), no de los tests. Gate ≥45%. -->
<!-- NV-03: higiene incremental excluida del calculo (migraciones, arranque, DTOs anemicos). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Include>[APISDD]*</Include>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/Migrations/*.cs,**/Program.cs,**/Dtos/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
