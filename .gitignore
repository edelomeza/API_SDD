# Política: jamás secretos en Git (critic B1 → FAIL). Tracked genéricos:
# appsettings.json + Development.json + Example.json (plantilla pública).
# Secretos solo en *.Local.json (git-ignored) o env. Ver AGENTS.md §1/§3.

# === .NET build (nunca binarios) ===
[Bb]in/
[Oo]bj/
*.user
*.suo
*.sln.docstates
.vs/
.idea/
*.nupkg
*.snupkg

# === tests / coverage / mutation (pueden llevar connection strings en logs) ===
TestResults/
*.trx
*.coverage
*.coveragexml
coverage*/
coverage.txt
StrykerOutput/
BenchmarkDotNet.Artifacts/
reports/
logs/

# === publish / run local ===
publish/
out/
artifacts/

# === secretos y config local (DevSecOps: denegar por defecto) ===
appsettings.Local.json
appsettings.*.Local.json
*.Private.json
secrets.json
.env
.env.*
deploy/.env
# DataProtection KeysPath fuera de wwwroot — jamás al repo
keys/
*_keys/
*.key.xml
*.pfx
*.key
*.pem
*.pfx.txt
*.publishsettings
*.pubxml.user

# === DB locales (canónica externa; locales de contenedores/pruebas fuera) ===
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.mdf
*.ldf
*.ndf

# === python (scripts/) ===
__pycache__/
*.py[cod]
.venv/
.venv*/

