<?xml version="1.0" encoding="utf-8"?>
<!-- NV-01: solo nuget.org (supply-chain). Ver 09-ci-matrix / 07-quality-supply-chain. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
      <package pattern="SonarAnalyzer.*" />
      <package pattern="xunit*" />
      <package pattern="coverlet*" />
      <package pattern="FluentAssertions*" />
      <package pattern="Moq*" />
      <package pattern="FsCheck*" />
      <package pattern="Serilog*" />
      <package pattern="Scalar.*" />
      <package pattern="Testcontainers*" />
      <package pattern="Asp.*" />
      <package pattern="Castle.*" />
      <package pattern="Docker.*" />
      <package pattern="Fluent*" />
      <package pattern="Konscious.*" />
      <package pattern="BCrypt.*" />
      <package pattern="Otp.NET" />
      <package pattern="Azure.Core" />
      <package pattern="Azure.Identity" />
      <package pattern="BouncyCastle.Cryptography" />
      <package pattern="FSharp.Core" />
      <package pattern="Humanizer.Core" />
      <package pattern="Mono.TextTemplating" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="SharpZipLib" />
      <package pattern="SSH.NET" />
    </packageSource>
  </packageSourceMapping>
</configuration>
